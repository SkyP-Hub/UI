-- SkyP Debug: Pohon & Animasi (file terpisah, tidak butuh script utama / key)
-- Cara pakai: masuk world, tanam minimal 2 seed, lalu jalankan file ini di executor.
-- Hasil: disalin ke clipboard + disimpan ke SkyP_debug.txt (folder workspace executor) + dicetak di console.
-- Hanya MEMBACA data game, tidak mengubah apa pun.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local WorldRemotes = ReplicatedStorage:FindFirstChild("WorldRemotes") or Instance.new("Folder")

local function say(text)
    print("[SkyP Debug] " .. text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", { Title = "SkyP Debug", Text = text, Duration = 8 })
    end)
end

local function getUpvalues(fn)
    if debug and debug.getupvalues then
        local ok, ups = pcall(debug.getupvalues, fn)
        if ok and type(ups) == "table" then return ups end
    end
    local out = {}
    local gu = (debug and debug.getupvalue) or getupvalue
    if gu then
        for i = 1, 60 do
            local ok, v = pcall(gu, fn, i)
            if not ok then break end
            out[i] = v
        end
    end
    return out
end

local function keysOf(t, max)
    local out, n = {}, 0
    pcall(function()
        for k, v in next, t do
            n = n + 1
            if n <= max then
                local tv = type(v)
                local extra = (tv == "number" or tv == "boolean") and ("=" .. tostring(v)) or ""
                out[#out + 1] = tostring(k) .. ":" .. tv .. extra
            end
        end
    end)
    return table.concat(out, ", ") .. (n > max and (" ...+" .. (n - max)) or "")
end

-- Di sebagian executor (mis. Delta) getgc hampir kosong dan fungsi baca konstanta bernama lain.
local getconsts = (debug and debug.getconstants) or getconstants or getconsts

local function isMine(fn)
    if isexecutorclosure then
        local ok, res = pcall(isexecutorclosure, fn)
        if ok and res then return true end
    end
    return false
end

-- Data dasar: World (punya fg & bg) & data item (tabel berisi { name, id, kind, ... }).
-- Dicari dengan MENELUSURI isi tabel & upvalue fungsi game, mulai dari fungsi loop game (RenderStepped dll),
-- handler remote world, getgc (kalau ada isinya) dan modul yang sudah dimuat. Sama seperti cara SkyP di executor ini.
-- gc = daftar semua tabel & fungsi yang terjangkau (dipakai scan pohon & animasi).
local World, WW, WH, ItemDB, nItems, nItemTabs = nil, 0, 0, {}, 0, 0
local gc, gcErr, baseInfo = nil, nil, ""
local function findBase()
    local seen, queue = {}, {}
    seen[seen], seen[queue], seen[ItemDB] = true, true, true
    local function push(x)
        if not seen[x] then
            seen[x] = true
            queue[#queue + 1] = x
        end
    end
    local nLoop, nRemote, nGc, nMod = 0, 0, 0, 0
    if getconnections then
        for _, name in ipairs({ "RenderStepped", "Heartbeat", "Stepped", "PreRender", "PreSimulation", "PostSimulation" }) do
            local okS, sig = pcall(function() return RunService[name] end)
            if okS and sig then
                local ok, conns = pcall(getconnections, sig)
                if ok and type(conns) == "table" then
                    for _, c in ipairs(conns) do
                        local okf, fn = pcall(function() return c.Function end)
                        if okf and type(fn) == "function" and not isMine(fn) then
                            nLoop = nLoop + 1
                            push(fn)
                        end
                    end
                end
            end
        end
        pcall(function()
            for _, ev in ipairs(WorldRemotes:GetChildren()) do
                if ev:IsA("RemoteEvent") then
                    local ok, conns = pcall(getconnections, ev.OnClientEvent)
                    if ok and type(conns) == "table" then
                        for _, c in ipairs(conns) do
                            local okf, fn = pcall(function() return c.Function end)
                            if okf and type(fn) == "function" and not isMine(fn) then
                                nRemote = nRemote + 1
                                push(fn)
                            end
                        end
                    end
                end
            end
        end)
    end
    if getgc then
        local okG, list = pcall(getgc, true)
        if okG and type(list) == "table" then
            seen[list] = true
            for gi = 1, #list do -- bukan ipairs: daftar getgc bisa bolong
                local v = list[gi]
                local tv = type(v)
                if tv == "table" or (tv == "function" and not isMine(v)) then
                    nGc = nGc + 1
                    push(v)
                end
            end
        end
    end
    if getloadedmodules then
        pcall(function()
            for _, m in ipairs(getloadedmodules()) do
                local ok, v = pcall(require, m)
                if ok and (type(v) == "table" or type(v) == "function") then
                    nMod = nMod + 1
                    push(v)
                end
            end
        end)
    end
    if #queue == 0 then
        gcErr = "Tidak ada titik awal penelusuran (getconnections / getgc / getloadedmodules tidak ada atau kosong)"
        return
    end
    local qi, nodes = 1, 0
    while qi <= #queue and nodes < 150000 do
        local x = queue[qi]
        qi = qi + 1
        nodes = nodes + 1
        if nodes % 1500 == 0 then task.wait() end
        if type(x) == "function" then
            if not (iscclosure and iscclosure(x)) and not isMine(x) then
                local ups = {}
                pcall(function() ups = getUpvalues(x) end)
                for _, u in pairs(ups) do
                    local tu = type(u)
                    if tu == "table" or tu == "function" then push(u) end
                end
            end
        else
            pcall(function()
                local fg, bg = rawget(x, "fg"), rawget(x, "bg")
                local isWorld = type(fg) == "table" and type(bg) == "table"
                    and (type(rawget(x, "call")) == "function" or type(rawget(x, "dropList")) == "function"
                        or (type(rawget(x, "w")) == "number" and rawget(x, "spawn") ~= nil))
                if isWorld and not World then World = x end
                -- tabel item: isi pertamanya { name = teks, ... }; id dari field id atau dari kuncinya
                local k1, a = next(x)
                if not isWorld and type(a) == "table" and type(rawget(a, "name")) == "string"
                    and (type(rawget(a, "id")) == "number" or type(k1) == "number") then
                    local added = 0
                    for k, it in next, x do
                        if type(it) == "table" and type(rawget(it, "name")) == "string" then
                            local id = rawget(it, "id")
                            if type(id) ~= "number" then id = (type(k) == "number") and k or nil end
                            if id and (ItemDB[id] == nil or (rawget(ItemDB[id], "kind") == nil and rawget(it, "kind") ~= nil)) then
                                ItemDB[id] = it
                                added = added + 1
                            end
                        end
                    end
                    if added > 0 then
                        nItemTabs = nItemTabs + 1
                        nItems = nItems + added
                    end
                    return -- isi tabel item tidak ditelusuri
                end
                local n = 0
                for k, v in next, x do
                    n = n + 1
                    if n > 600 then break end
                    local tv = type(v)
                    if (tv == "table" or tv == "function") and not (isWorld and (k == "fg" or k == "bg")) then push(v) end
                end
            end)
        end
    end
    gc = queue
    baseInfo = ("akar: loop=%d remote=%d getgc=%d modul=%d | ditelusuri %d dari %d%s"):format(
        nLoop, nRemote, nGc, nMod, nodes, #queue, qi <= #queue and " (BATAS tercapai)" or "")
    -- ukuran world: pakai w & h kalau ada, kalau tidak dihitung dari grid tile
    if World then
        pcall(function()
            local w, h = rawget(World, "w"), rawget(World, "h")
            if type(w) == "number" and type(h) == "number" then
                WW, WH = w, h
                return
            end
            local mx, my = -1, -1
            for y, row in next, rawget(World, "fg") do
                if type(y) == "number" and type(row) == "table" then
                    if y > my then my = y end
                    for x in next, row do
                        if type(x) == "number" and x > mx then mx = x end
                    end
                end
            end
            WW, WH = mx + 1, my + 1
        end)
    end
end

local function debugTA()
    local L = {}
    local function short(s, n)
        s = tostring(s)
        if #s > n then return string.sub(s, 1, n) .. "~" end
        return s
    end
    local function add(x) L[#L + 1] = short(x, 420) end
    local w = World
    local st = 0
    pcall(function() st = workspace:GetServerTimeNow() end)
    local function fnInfo(fn)
        local src, line, name, np = "?", "?", "?", "?"
        pcall(function() src = debug.info(fn, "s") end)
        pcall(function() line = debug.info(fn, "l") end)
        pcall(function() name = debug.info(fn, "n") end)
        pcall(function() np = debug.info(fn, "a") end)
        src = tostring(src)
        if #src > 28 then src = "~" .. string.sub(src, -28) end
        return ("%s:%s '%s' param=%s"):format(src, tostring(line), tostring(name), tostring(np))
    end
    local function strConsts(fn, max)
        if not getconsts then return "(getconsts tidak ada)" end
        local ok, consts = pcall(getconsts, fn)
        if not ok or type(consts) ~= "table" then return "(gagal baca konstanta)" end
        local out, n = {}, 0
        for _, c in pairs(consts) do
            if type(c) == "string" and #c > 0 then
                n = n + 1
                if n <= max then out[#out + 1] = short(c, 22) end
            end
        end
        return table.concat(out, ",") .. (n > max and (" ...+" .. (n - max)) or "")
    end
    local function valInfo(v)
        if type(v) == "table" then return "{" .. keysOf(v, 8) .. "}" end
        return type(v) .. "=" .. short(v, 18)
    end
    -- isi 1 nilai sampai 2 tingkat (sub-tabel ikut dibuka)
    local function deepInfo(v)
        if type(v) ~= "table" then return type(v) .. "=" .. short(v, 18) end
        local out, n = {}, 0
        pcall(function()
            for k, x in next, v do
                n = n + 1
                if n <= 16 then
                    local tx = type(x)
                    if tx == "table" then
                        out[#out + 1] = tostring(k) .. ":{" .. keysOf(x, 8) .. "}"
                    elseif tx == "number" or tx == "boolean" or tx == "string" then
                        out[#out + 1] = tostring(k) .. "=" .. short(x, 16)
                    else
                        out[#out + 1] = tostring(k) .. ":" .. tx
                    end
                end
            end
        end)
        return "{" .. table.concat(out, ", ") .. (n > 16 and (" ...+" .. (n - 16)) or "") .. "}"
    end
    local function tblInfo(t)
        local n, k1, v1 = 0, nil, nil
        pcall(function()
            for k, v in next, t do
                n = n + 1
                if n == 1 then k1, v1 = k, v end
                if n >= 3000 then break end
            end
        end)
        local mt = false
        pcall(function() mt = getmetatable(t) ~= nil end)
        return ("isi=%s%d kunci1=%s(%s) nilai1=%s meta=%s"):format(
            n >= 3000 and ">=" or "", n, short(k1, 14), type(k1), valInfo(v1), tostring(mt))
    end
    -- daftar upvalue berurutan: { { i = nomor, v = nilai }, ... }, jumlah
    local function upList(fn, max)
        local ups = {}
        pcall(function() ups = getUpvalues(fn) end)
        local keys = {}
        for i in pairs(ups) do
            if type(i) == "number" then keys[#keys + 1] = i end
        end
        table.sort(keys)
        local out = {}
        for n, i in ipairs(keys) do
            if n > max then break end
            out[#out + 1] = { i = i, v = ups[i] }
        end
        return out, #keys
    end

    -- Tabel bersama (kunci teks, ratusan isi = variabel modul game): cari anak tabel yang menyimpan data per tile
    local sharedSeen, sampleRef = {}, nil
    local function dumpShared(t, pad)
        if sharedSeen[t] or type((next(t))) ~= "string" then return end
        sharedSeen[t] = true
        local numNames, nNum, nChild = {}, 0, 0
        pcall(function()
            for k, sub in next, t do
                if type(sub) == "table" then
                    nChild = nChild + 1
                    local entry = nil
                    for _, s in ipairs(sampleRef or {}) do
                        entry = rawget(sub, s.idx)
                        if entry == nil then entry = rawget(sub, s.x .. "," .. s.y) end
                        if entry == nil then
                            local r = rawget(sub, s.y)
                            if type(r) == "table" then entry = rawget(r, s.x) end
                        end
                        if entry ~= nil then break end
                    end
                    if entry ~= nil then
                        add(("%s.%s: ADA DATA DI POSISI POHON | %s"):format(pad, tostring(k), tblInfo(sub)))
                        add(("%s    isi: %s"):format(pad, deepInfo(entry)))
                    elseif type((next(sub))) == "number" then
                        nNum = nNum + 1
                        if #numNames < 40 then numNames[#numNames + 1] = tostring(k) end
                    end
                end
            end
        end)
        add(("%s(tabel bersama: %d anak tabel, %d berkunci angka: %s)"):format(pad, nChild, nNum, table.concat(numNames, ",")))
    end

    add("== SkyP Debug Pohon & Animasi v3 ==")
    local exName = "?"
    if identifyexecutor then
        local okE, n, v = pcall(identifyexecutor)
        if okE then exName = tostring(n) .. (v and (" " .. tostring(v)) or "") end
    end
    add("Executor : " .. exName .. " | PlaceVersion " .. tostring(game.PlaceVersion))
    add(("Fungsi   : getgc=%s getconstants=%s getconnections=%s getupvalues=%s getupvalue=%s setupvalue=%s islclosure=%s isexecutorclosure=%s"):format(
        tostring(getgc ~= nil), tostring(getconsts ~= nil), tostring(getconnections ~= nil),
        tostring(debug ~= nil and debug.getupvalues ~= nil),
        tostring((debug ~= nil and debug.getupvalue ~= nil) or getupvalue ~= nil),
        tostring((debug ~= nil and debug.setupvalue ~= nil) or setupvalue ~= nil),
        tostring(islclosure ~= nil), tostring(isexecutorclosure ~= nil)))
    add(("Data dasar: World=%s | ItemDB=%d item dari %d tabel"):format(w and "ketemu" or "TIDAK", nItems, nItemTabs))
    add("Penelusuran: " .. tostring(baseInfo))
    add("Waktu server: " .. tostring(math.floor(st)))

    ---------------- POHON ----------------
    add("")
    add("---- POHON ----")
    local samples, nSeed, nSeedName = {}, 0, 0
    if not w then
        add("World belum ketemu di memori. Masuk ke world dulu, lalu jalankan lagi")
    else
        add(("World %sx%s (w=%s h=%s di tabel World)"):format(tostring(WW), tostring(WH), type(rawget(w, "w")), type(rawget(w, "h"))))
        -- pohon yang ada di world sekarang (tile fg berisi seed)
        pcall(function()
            for y, row in next, rawget(w, "fg") do
                if type(y) == "number" and type(row) == "table" then
                    for x, id in next, row do
                        if type(x) == "number" and type(id) == "number" and id ~= 0 then
                            local it = ItemDB[id]
                            local byKind = it ~= nil and it.kind == "seed"
                            local byName = it ~= nil and type(it.name) == "string" and string.find(string.lower(it.name), "seed") ~= nil
                            if byKind then nSeed = nSeed + 1 end
                            if byName and not byKind then nSeedName = nSeedName + 1 end
                            if (byKind or byName) and #samples < 3 then
                                samples[#samples + 1] = { x = x, y = y, idx = y * WW + x, id = id }
                            end
                        end
                    end
                end
            end
        end)
        add(("Pohon di world: %d (kind=seed) | %d (hanya nama mengandung 'seed')"):format(nSeed, nSeedName))
        for i, s in ipairs(samples) do
            local it = ItemDB[s.id]
            add(("  contoh %d: (%d,%d) idx=%d id=%d item={%s}"):format(i, s.x, s.y, s.idx, s.id,
                it and keysOf(it, 14) or "tidak ada di ItemDB"))
        end
        if #samples == 0 then
            add("  ! Tidak ada pohon di world ini. Tanam minimal 2 seed dulu, lalu jalankan debug lagi (supaya datanya bisa dilacak)")
        end

        -- isi World: fungsi & tabel
        local fnNames, tbNames = {}, {}
        pcall(function()
            for k, v in next, w do
                if type(v) == "function" then
                    fnNames[#fnNames + 1] = tostring(k)
                elseif type(v) == "table" then
                    tbNames[#tbNames + 1] = tostring(k)
                end
            end
        end)
        table.sort(fnNames)
        table.sort(tbNames)
        add(("Fungsi World (%d): %s"):format(#fnNames, table.concat(fnNames, ",")))
        add(("Tabel World (%d):"):format(#tbNames))
        for i, k in ipairs(tbNames) do
            if i > 30 then
                add("  ...")
                break
            end
            local v = rawget(w, k)
            if k == "fg" or k == "bg" then
                add("  " .. k .. ": (grid tile)")
            elseif type(v) == "table" then
                add("  " .. k .. ": " .. tblInfo(v))
            end
        end

        -- fungsi akar yang dipakai pencari pohon SkyP + fungsi World yang namanya berbau pohon
        local roots, seenRoot = {}, {}
        for _, name in ipairs({ "tileChanged", "treeChanged", "setTree" }) do
            roots[#roots + 1] = name
            seenRoot[name] = true
        end
        for _, name in ipairs(fnNames) do
            local low = string.lower(name)
            if not seenRoot[name] and (string.find(low, "tree") or string.find(low, "plant") or string.find(low, "seed")
                or string.find(low, "grow") or string.find(low, "harvest") or string.find(low, "splice")) then
                roots[#roots + 1] = name
                seenRoot[name] = true
            end
        end
        sampleRef = samples
        for ri, name in ipairs(roots) do
            if ri > 8 then
                add("(akar lain dilewati)")
                break
            end
            local f = rawget(w, name)
            if type(f) ~= "function" then
                add(("Akar World.%s: TIDAK ADA (%s)"):format(name, type(f)))
            else
                local ups, nUp = upList(f, 24)
                add(("Akar World.%s: %s | upvalue %d | konst: %s"):format(name, fnInfo(f), nUp, strConsts(f, 18)))
                local tset = {}
                for _, e in ipairs(ups) do
                    if type(e.v) == "table" and not rawequal(e.v, w) then tset[e.v] = true end
                end
                for _, e in ipairs(ups) do
                    local v = e.v
                    if rawequal(v, w) then
                        add(("  up%d: = World"):format(e.i))
                    elseif type(v) == "table" then
                        add(("  up%d: tabel %s"):format(e.i, tblInfo(v)))
                        if type((next(v))) == "number" then
                            local _, e1 = next(v)
                            add("      isi pertama: " .. deepInfo(e1))
                        end
                        dumpShared(v, "      ")
                    elseif type(v) == "function" then
                        local gu2 = {}
                        pcall(function() gu2 = getUpvalues(v) end)
                        local hasW, nT, nShared, nAll = false, 0, 0, 0
                        for _, x in pairs(gu2) do
                            nAll = nAll + 1
                            if rawequal(x, w) then
                                hasW = true
                            elseif type(x) == "table" then
                                nT = nT + 1
                                if tset[x] then nShared = nShared + 1 end
                            end
                        end
                        add(("  up%d: fungsi %s | up=%d World=%s tabel=%d sama=%d | konst: %s"):format(e.i, fnInfo(v),
                            nAll, tostring(hasW), nT, nShared, strConsts(v, 12)))
                    else
                        add(("  up%d: %s=%s"):format(e.i, type(v), short(v, 20)))
                    end
                end
            end
        end
        add(("Remote world: TreeChanged=%s"):format(tostring(WorldRemotes:FindFirstChild("TreeChanged") ~= nil)))
    end

    ---------------- SCAN MEMORI (pohon + animasi sekaligus) ----------------
    local treeCands, armCands, nArm = {}, {}, 0
    local nTab, nFn = 0, 0
    add("")
    if not gc then
        add(tostring(gcErr or "penelusuran tidak jalan"))
    else
        local need = math.min(2, #samples)
        local fg, bg = w and rawget(w, "fg"), w and rawget(w, "bg")
        local function timeLike(e)
            return type(e) == "number" and math.abs(e - st) < 86400 * 90
        end
        for i, v in ipairs(gc) do
            if i % 1500 == 0 then task.wait() end
            local tv = type(v)
            if tv == "table" then
                nTab = nTab + 1
                if need > 0 and #treeCands < 8 and not rawequal(v, w) and not rawequal(v, fg) and not rawequal(v, bg)
                    and not rawequal(v, L) and not rawequal(v, samples) and not rawequal(v, gc) and not rawequal(v, ItemDB) then
                    pcall(function()
                        local hitIdx, hitXy, hitRows, entry = 0, 0, 0, nil
                        for _, s in ipairs(samples) do
                            local e = rawget(v, s.idx)
                            if type(e) == "table" or timeLike(e) then
                                hitIdx = hitIdx + 1
                                entry = entry or e
                            end
                            local e2 = rawget(v, s.x .. "," .. s.y)
                            if e2 ~= nil then
                                hitXy = hitXy + 1
                                entry = entry or e2
                            end
                            local r = rawget(v, s.y)
                            if type(r) == "table" then
                                local e3 = rawget(r, s.x)
                                if type(e3) == "table" or timeLike(e3) then
                                    hitRows = hitRows + 1
                                    entry = entry or e3
                                end
                            end
                        end
                        local form = (hitIdx >= need and "idx") or (hitXy >= need and "xy") or (hitRows >= need and "rows") or nil
                        if form then
                            treeCands[#treeCands + 1] = { t = v, form = form, entry = entry }
                        end
                    end)
                end
            elseif tv == "function" then
                nFn = nFn + 1
                if getconsts then
                    pcall(function()
                        if islclosure and not islclosure(v) then return end
                        if isexecutorclosure and isexecutorclosure(v) then return end
                        local consts = getconsts(v)
                        if type(consts) ~= "table" then return end
                        local a, b, c, fuzzy, mine = false, false, false, false, false
                        for _, k in pairs(consts) do
                            if type(k) == "string" then
                                if k == "SKYP_DBG_MARK" then mine = true -- fungsi debug ini sendiri
                                elseif k == "forearm" then a = true
                                elseif k == "heldReach" then b = true
                                elseif k == "punchReach" then c = true
                                else
                                    local low = string.lower(k)
                                    if string.find(low, "forearm", 1, true) or string.find(low, "heldreach", 1, true)
                                        or string.find(low, "punchreach", 1, true) then
                                        fuzzy = true
                                    end
                                end
                            end
                        end
                        if (a or b or c or fuzzy) and not mine then
                            nArm = nArm + 1
                            if #armCands < 10 then
                                armCands[#armCands + 1] = { fn = v, a = a, b = b, c = c, fuzzy = fuzzy }
                            end
                        end
                    end)
                end
            end
        end
        add(("Scan: %d objek terjangkau (%d tabel, %d fungsi)"):format(#gc, nTab, nFn))
    end

    add("Tabel yang berisi data di posisi pohon contoh: " .. #treeCands)
    for i, c in ipairs(treeCands) do
        add(("  T%d bentuk=%s | %s"):format(i, c.form, tblInfo(c.t)))
        add("      isi di pohon contoh: " .. deepInfo(c.entry))
    end

    ---------------- ANIMASI ----------------
    add("")
    add("---- ANIMASI ----")
    add(("Fungsi game yang menyebut forearm / heldReach / punchReach: %d"):format(nArm))
    local armSet = {}
    for i, c in ipairs(armCands) do
        armSet[c.fn] = i
        local full = c.a and c.b and c.c
        add(("  A%d %s forearm=%s heldReach=%s punchReach=%s mirip=%s | %s"):format(i, full and "[COCOK]" or "[sebagian]",
            tostring(c.a), tostring(c.b), tostring(c.c), tostring(c.fuzzy), fnInfo(c.fn)))
        add("      konst: " .. strConsts(c.fn, 40))
        local ups, nUp = upList(c.fn, 16)
        local parts = {}
        for _, e in ipairs(ups) do
            local v = e.v
            local d = type(v)
            if d == "table" then
                d = "{" .. keysOf(v, 5) .. "}"
            elseif d ~= "function" and d ~= "nil" then
                d = d .. "=" .. short(v, 12)
            end
            parts[#parts + 1] = e.i .. ":" .. d
        end
        -- sama dengan pencari SkyP: upvalue kosong / tabel {t, facing} sebelum upvalue terakhir yang terisi
        local bindIdx, lastI = nil, 0
        local gu = (debug and debug.getupvalue) or getupvalue
        if gu then
            local vals = {}
            for k = 1, 16 do
                local ok, v = pcall(gu, c.fn, k)
                if not ok then break end
                vals[k] = v
                if v ~= nil then lastI = k end
            end
            for k = 1, lastI - 1 do
                local v = vals[k]
                if v == nil or (type(v) == "table" and rawget(v, "t") ~= nil and rawget(v, "facing") ~= nil) then
                    bindIdx = k
                    break
                end
            end
        end
        add(("      upvalue %d (terakhir terisi %d) | bind=%s | %s"):format(nUp, lastI, tostring(bindIdx), table.concat(parts, " ")))
    end
    if nArm == 0 then
        add(getconsts and "  ! Tidak ada fungsi yang cocok: nama di kode game berubah, atau fungsinya tidak terjangkau penelusuran"
            or "  ! Executor tidak punya debug.getconstants / getconstants: fungsi tangan tidak bisa dikenali")
    end

    -- jalur dari loop game (RenderStepped dll) ke fungsi tangan (pencari SkyP hanya melihat kedalaman 1)
    if not getconnections then
        add("getconnections tidak ada: pencari animasi SkyP tidak bisa jalan di executor ini")
    else
        for _, name in ipairs({ "RenderStepped", "Heartbeat", "PreRender", "Stepped" }) do
            local okS, sig = pcall(function() return RunService[name] end)
            local nConn, nFnc, found = 0, 0, nil
            if okS and sig then
                local ok, conns = pcall(getconnections, sig)
                if ok and type(conns) == "table" then
                    local queue, depth, seen = {}, {}, {}
                    for _, cn in ipairs(conns) do
                        nConn = nConn + 1
                        local okf, fn = pcall(function() return cn.Function end)
                        if okf and type(fn) == "function" and not seen[fn] then
                            nFnc = nFnc + 1
                            seen[fn] = true
                            queue[#queue + 1] = fn
                            depth[fn] = 0
                        end
                    end
                    local qi = 1
                    while qi <= #queue and qi <= 2500 and not found do
                        local fn = queue[qi]
                        qi = qi + 1
                        if qi % 400 == 0 then task.wait() end
                        if armSet[fn] then
                            found = ("A%d di kedalaman %d"):format(armSet[fn], depth[fn])
                        elseif depth[fn] < 5 then
                            local ups = {}
                            pcall(function() ups = getUpvalues(fn) end)
                            for _, u in pairs(ups) do
                                if type(u) == "function" and not seen[u] then
                                    seen[u] = true
                                    depth[u] = depth[fn] + 1
                                    queue[#queue + 1] = u
                                end
                            end
                        end
                    end
                else
                    add(("  %s: getconnections gagal (%s)"):format(name, tostring(conns)))
                end
            end
            add(("  %s: %d koneksi, %d fungsi terbaca | fungsi tangan: %s"):format(name, nConn, nFnc,
                found or "tidak terjangkau (sampai kedalaman 5)"))
        end
    end
    return table.concat(L, "\n")
end

